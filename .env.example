# Choose one provider: "anthropic", "openai", or "groq" (groq is free, no billing required)
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Required if LLM_PROVIDER=groq — free key, no card required: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Vector store settings
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=support_docs

# Embedding model (local, runs via sentence-transformers — no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval settings
# Final number of chunks sent to the LLM as context.
RETRIEVAL_K=4
# Candidate pool size pulled by embedding distance before reranking — wider
# than RETRIEVAL_K so a semantically-correct but differently-worded chunk
# survives long enough for the reranker to recognize it.
FETCH_K=12
# Cross-encoder relevance gate (raw logit scale, roughly -11..+11). This is
# what actually decides relevance — lower = more lenient (more chunks pass),
# higher = stricter. Do not "fix" bad retrieval by loosening this until
# unrelated chunks get through; tune the reranker/candidate pool instead.
RERANK_SCORE_THRESHOLD=-8.0
# Legacy raw-L2-distance cutoff from before reranking was added. No longer
# gates results — kept only for the debug panel's before/after comparison.
RELEVANCE_SCORE_THRESHOLD=1.5

# Development-only diagnostics (normalized query, candidate scores, sources)
# shown in a collapsed expander below each answer. Never enable this in a
# deployed/public instance — leave "false" for normal users.
DEBUG_MODE=false
