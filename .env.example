# Choose one provider: "anthropic", "openai", or "groq" (groq is free, no billing required)
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Required if LLM_PROVIDER=groq — free key, no card required: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Vector store settings
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=support_docs

# Embedding model (local, runs via sentence-transformers — no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval settings
RETRIEVAL_K=4
# Chroma returns L2 distance (0 = identical, ~2 = unrelated for this embedding
# model). Lower threshold = stricter (fewer false positives, more "I don't know").
RELEVANCE_SCORE_THRESHOLD=1.5
